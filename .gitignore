.DS_Store

# Swift / Xcode
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# Generated development status (published as an Actions / Pages artifact)
build/progress/
__pycache__/

# Secrets never belong in this repository
.env
.env.*
*.pem
*.key
*.p12
*.p8

# Osobní nastavení Pi (agenti, prompty, rozšíření) — není součást projektu
# Drží se mimo repo: viz README "Zákaz atribuce", CI a docs/GUIDE.md
/.pi/
